generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  spotifyAccount SpotifyAccount?
  plays         Play[]
  sessions      Session[]
}

model SpotifyAccount {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique
  spotifyUserId  String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Artist {
  id               String   @id @default(uuid())
  spotifyArtistId  String   @unique
  name             String
  createdAt        DateTime @default(now())
}

model Track {
  id               String   @id @default(uuid())
  spotifyTrackId   String   @unique
  name             String
  albumName        String?
  durationMs       Int?
  primaryArtistId  String?
  createdAt        DateTime @default(now())
  audioFeatures    TrackAudioFeature?
  plays            Play[]
}

model TrackArtist {
  trackId  String
  artistId String
  @@id([trackId, artistId])
}

model TrackAudioFeature {
  trackId        String   @id
  tempo           Float?
  energy          Float?
  valence         Float?
  danceability    Float?
  acousticness    Float?
  instrumentalness Float?
  loudness        Float?
  mode            Int?
  timeSignature   Int?
  fetchedAt       DateTime @default(now())
}

model Play {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  track      Track    @relation(fields: [trackId], references: [id])
  trackId    String
  playedAt   DateTime
  contextType String?
  contextName String?
  msPlayed   Int?
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  plays     Play[]  @relation()
}

model SessionPlay {
  sessionId String
  playId    String
  @@id([sessionId, playId])
}

model SessionLabel {
  sessionId   String   @id
  preFocus     Int?
  preStress    Int?
  preEnergy    Int?
  postFocus    Int?
  postStress   Int?
  postEnergy   Int?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SessionPrediction {
  id                   String   @id @default(uuid())
  sessionId            String
  modelVersion         String
  predictedFocusDelta  Int?
  predictedStressDelta Int?
  predictedEnergyDelta Int?
  predictedMoodCategory String?
  createdAt            DateTime @default(now())
}
